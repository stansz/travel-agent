[Unit]
Description=Travel Agent Chat (FastAPI + Pi)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/travel-agent:latest
ContainerName=travel-agent

# Host networking — shares host network stack, can reach 127.0.0.1:5000 (LibreTranslate)
Network=host

# Mount travel skills (read-only for safety)
Volume=/home/ubuntu/.hermes/skills/travel:/app/travel:ro

# Mount app.py + Pi skill + data dir (data needs rw for sessions DB)
Volume=/home/ubuntu/.hermes/skills/travel/travel-agent/web/app.py:/app/web/app.py:ro
Volume=/home/ubuntu/.hermes/skills/travel/travel-agent/web/pi-skill.md:/app/web/pi-skill.md:ro
Volume=/home/ubuntu/.hermes/skills/travel/travel-agent/data:/app/data

# Mount .env for API keys
Volume=/home/ubuntu/.hermes/.env:/app/.env:ro

# Mount Pi config from host (needs read-write for session locks)
Volume=/home/ubuntu/.pi:/root/.pi

# Mount himalaya for email
Volume=/home/ubuntu/.hermes/workspace/bin/himalaya:/usr/local/bin/himalaya:ro
Volume=/home/ubuntu/.config/himalaya:/root/.config/himalaya:ro

# Environment
Environment=HOME=/root
Environment=PI_PROVIDER=zai
Environment=PI_MODEL=glm-5-turbo
Environment=ZAI_API_KEY=7e41ed7a82274cc3844fd28a6e51fa82.f27g2vYEPnZseZiL

Pull=never

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=60

[Install]
WantedBy=default.target
