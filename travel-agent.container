[Unit]
Description=Travel Agent Chat (FastAPI + Pi)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/travel-agent:latest
ContainerName=travel-agent
Pull=never

# Port
PublishPort=127.0.0.1:8092:8092

# App code (read-only)
Volume=/home/sz/travel-agent/app.py:/app/web/app.py:ro
Volume=/home/sz/travel-agent/pi-skill.md:/app/web/pi-skill.md:ro

# Travel skill tree: travel.py + sibling scripts (airlabs, aviationstack,
# yvr-deals, libretranslate, travel-utils, travel-advisories, travelpayouts).
# travel.py resolves SKILL_DIR from its own path, so it must live at
# /app/travel/travel-agent/scripts/travel.py for the siblings to be found.
Volume=/home/sz/.hermes/skills/travel:/app/travel:ro
# Repo copy is the source of truth; shadows the skills copy above
Volume=/home/sz/travel-agent/travel.py:/app/travel/travel-agent/scripts/travel.py:ro

# API keys for the skill scripts (they read $HOME/.hermes/.env)
Volume=/home/sz/.hermes/.env:/root/.hermes/.env:ro

# Data dir (read-write for sessions DB)
Volume=/home/sz/travel-agent/data:/app/data

# Pi config
Volume=/home/sz/.pi:/root/.pi

# Environment
Environment=HOME=/root
Environment=PORT=8092
Environment=PI_PROVIDER=zai
Environment=PI_MODEL=glm-5.3-flash
Environment=PI_THINKING=high
Environment=ZAI_API_KEY=7e41ed7a82274cc3844fd28a6e51fa82.f27g2vYEPnZseZiL

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=60

[Install]
WantedBy=default.target
